    "journey.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folge einem sanften Pfad kleiner Motive, öffne Seite für Seite und lass das Sammelbuch sich langsam füllen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow a soft trail of tiny artworks, open each new page, and let the collection book quietly fill itself in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue un suave sendero de pequeñas ilustraciones, abre cada nueva página y deja que el libro de colección se llene poco a poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez un doux parcours de petites illustrations, ouvrez chaque nouvelle page et laissez le livre se remplir doucement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな作品をたどるやさしい道を進み、新しいページを開きながら、コレクションブックをそっと埋めていきましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 작품들이 이어지는 포근한 길을 따라가며 새 페이지를 열고, 컬렉션 북을 차분히 채워 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿着一条柔和的小作品旅程前进，翻开每一页，让收藏书慢慢被填满。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沿著柔和的小作品旅程前進，翻開每一頁，讓收藏書慢慢被填滿。"
          }
        }
      }
    },
