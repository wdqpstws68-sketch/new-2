    "journey.chapter.moonlit-shore.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stille Ozeanfarben und feine Details lassen dieses Kapitel ruhig ausklingen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet ocean colors and tiny details let this chapter settle into a calm finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los colores marinos serenos y los pequeños detalles hacen que este capítulo cierre con calma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des couleurs marines paisibles et de petits détails donnent à ce chapitre une conclusion toute en douceur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かな海の色と小さなディテールが、この章をやさしく締めくくります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고요한 바다빛과 작은 디테일이 이 챕터를 차분하게 마무리합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安静的海色与细小的细节，让这一章以平和的节奏收束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安靜的海色與細小的細節，讓這一章以平和的節奏收束。"
          }
        }
      }
    },
