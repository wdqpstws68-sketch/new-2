    "journey.chapter.starlit-garden.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachtblüten und leise Flügel halten dieses Kapitel sanft am Leuchten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Night blooms and quiet wings keep this chapter glowing softly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flores nocturnas y alas silenciosas mantienen este capítulo brillando con suavidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des fleurs nocturnes et des ailes silencieuses maintiennent ce chapitre dans une douce lueur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜に咲く花と静かな羽音が、この章をやさしく光らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밤에 피는 꽃과 조용한 날갯짓이 이 챕터를 은은하게 빛나게 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "夜里盛开的花与安静的翅影，让这一章始终柔和发亮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "夜裡盛開的花與安靜的翅影，讓這一章始終柔和發亮。"
          }
        }
      }
    },
