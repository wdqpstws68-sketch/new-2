        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aletas coloridas y flores brillantes aportan un ritmo un poco más atrevido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des nageoires colorées et des fleurs éclatantes donnent un rythme un peu plus vif."
          }
