    "journey.chapter.berry-meadow.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warme Rottöne und sanfte Waldformen führen dich in die Reise ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm reds and gentle woodland shapes ease you into the journey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rojos cálidos y suaves formas del bosque te introducen en el recorrido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des rouges chaleureux et de douces formes de forêt vous installent dans le voyage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あたたかな赤とやさしい森の形が、旅のはじまりをやわらかく彩ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따뜻한 붉은빛과 부드러운 숲의 형태가 여정의 시작을 편안하게 열어 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温暖的红色与柔和的森林轮廓，会轻轻带你进入这段旅程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫暖的紅色與柔和的森林輪廓，會輕輕帶你進入這段旅程。"
          }
        }
      }
    },
