    "journey.chapter.bakery-path.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanfte Süßigkeiten und Fruchttöne machen diese Seite besonders gemütlich."
