    "journey.chapter.petal-pond.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunte Flossen und leuchtende Blüten geben hier einen etwas mutigeren Rhythmus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorful fins and bright blooms add a slightly bolder rhythm."
          }
