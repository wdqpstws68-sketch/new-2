          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarjetas de colorear por números seleccionadas con cuidado, reinicios rápidos, respuesta suave y un bucle muy satisfactorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sélection de cartes à colorier par numéros avec redémarrage rapide, retour doux et une boucle de jeu très satisfaisante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すばやくやり直せて、やさしい手ざわりで、気持ちよく1ループ遊べる番号ぬりカードをそろえました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠른 재시작, 부드러운 피드백, 그리고 만족스러운 한 번의 루프로 즐기는 엄선된 컬러 바이 넘버 카드입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
