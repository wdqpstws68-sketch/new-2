    "event.cozyMorningWeek.banner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft starts, warm colors, and a tiny new keepsake every day."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やさしい朝、あたたかな色、そして毎日の小さな新作。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔和的开始、温暖的色彩，以及每天一件小小的新纪念。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "柔和的開始、溫暖的色彩，以及每天一件小小的新紀念。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comienzos suaves, colores cálidos y un pequeño recuerdo nuevo cada día."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanfte Anfänge, warme Farben und jeden Tag ein kleines neues Andenken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des débuts tout en douceur, des couleurs chaudes et un petit souvenir inédit chaque jour."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 시작, 따뜻한 색감, 그리고 매일 찾아오는 작은 새 기념품."
          }
        }
      }
    },
