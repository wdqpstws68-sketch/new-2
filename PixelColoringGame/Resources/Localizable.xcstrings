    "alert.persistenceRecovered.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We repaired your saved data store and restarted progress storage safely. If some progress still looks missing, it came from an unreadable older save."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存データの読み込みを修復して、進行の保存先を安全に作り直しました。もし一部の進行が見当たらない場合は、古いセーブデータが読み取れなかった部分です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们已修复你的存档并安全地重新建立了进度保存。如果仍有部分进度缺失，那部分来自无法读取的旧存档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們已修復你的存檔並安全地重新建立了進度保存。如果仍有部分進度缺失，那部分來自無法讀取的舊存檔。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos reparado tus datos guardados y reiniciado el almacenamiento del progreso de forma segura. Si aún falta parte del progreso, proviene de una partida antigua que no se pudo leer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben deinen Spielstand repariert und die Fortschrittsspeicherung sicher neu gestartet. Falls noch Fortschritt fehlt, stammt er aus einem älteren, nicht lesbaren Spielstand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons réparé votre sauvegarde et redémarré l'enregistrement de la progression en toute sécurité. Si une partie de votre progression manque encore, elle provenait d'une ancienne sauvegarde illisible."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 데이터를 복구하고 진행 저장소를 안전하게 다시 만들었습니다. 일부 진행 상황이 여전히 보이지 않는다면, 읽을 수 없었던 이전 저장 데이터에서 온 부분입니다."
          }
        }
      }
    },
