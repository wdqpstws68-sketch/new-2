    "alert.journeyReset.message" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixel Bloom entfaltet sich jetzt als Kapitelreise, daher wurde dein alter Level-Fortschritt zurückgesetzt, damit die neue Karte sauber beginnen kann. Deine App-Einstellungen und anderen Präferenzen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixel Bloom now unfolds as a chapter journey, so old level progress was cleared to give the new map a clean start. Your app settings and other preferences were left untouched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixel Bloom ahora se desarrolla como un viaje por capítulos, así que el progreso anterior se borró para que el nuevo mapa empiece limpio. La configuración de la app y tus demás preferencias se mantuvieron intactas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixel Bloom se déroule désormais comme un voyage en chapitres, donc votre ancienne progression a été effacée pour offrir un nouveau départ à la carte. Les réglages de l'app et vos autres préférences ont été conservés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixel Bloom は章ごとの旅として生まれ変わったため、新しいマップを気持ちよく始められるよう以前のレベル進捗をリセットしました。アプリ設定やその他の環境設定はそのまま残っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixel Bloom이 이제 챕터형 여정으로 바뀌어 새 지도를 깔끔하게 시작할 수 있도록 이전 레벨 진행 상황을 초기화했습니다. 앱 설정과 다른 환경설정은 그대로 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixel Bloom 现在改成了章节旅程，因此旧关卡进度已清除，以便从全新的地图重新开始。应用设置和其他偏好保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixel Bloom 現在改成了章節旅程，因此舊關卡進度已清除，方便從全新的地圖重新開始。應用設定和其他偏好都會保留。"
          }
        }
      }
    },
    "alert.journeyReset.title" : {
