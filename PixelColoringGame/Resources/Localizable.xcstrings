    "journey.chapter.tide-garden.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein luftiges Kapitel, in dem Meereswesen und sonnige Grüntöne alles leicht halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A breezy chapter where sea creatures and sunlit greens keep things light."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un capítulo ligero donde criaturas marinas y verdes soleados mantienen todo fresco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chapitre léger où les créatures marines et les verts ensoleillés gardent une ambiance aérienne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "海のいきものと日差しの緑で、軽やかに進む章です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바다 생물과 햇살 어린 초록빛이 가볍고 산뜻한 분위기를 이어 갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "海洋生物与阳光绿意，让这一章保持轻盈清新的节奏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "海洋生物與陽光綠意，讓這一章保持輕盈清新的節奏。"
          }
        }
      }
    },
