    "event.cozyMorningWeek.archiveSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm set of early-day stickers saved from the February event."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2月イベントの穏やかな朝作品をここに保存しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
